<Application x:Class="UsageBar.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Theme brushes (MenuBg, MenuFg, MenuBorder, Hover, WindowBg) are set in App.ApplyTheme, with Mindows' colors. -->
        <SolidColorBrush x:Key="Accent" Color="#2F6FE4"/>
        <FontFamily x:Key="UiFont">Pretendard, Segoe UI Variable Text, Segoe UI</FontFamily>
    </Application.Resources>
</Application>
