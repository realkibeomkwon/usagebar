<Window x:Class="UsageBar.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UsageBar" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" SizeToContent="Height" Width="340"
        Left="-20000" Top="-20000" Deactivated="Window_Deactivated" KeyDown="Window_KeyDown"
        Foreground="{DynamicResource MenuFg}" FontFamily="{StaticResource UiFont}" FontSize="13">
    <Window.Resources>
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource MenuFg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="10,5">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Dim" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.6"/>
        </Style>
    </Window.Resources>

    <!-- The margin leaves room for the shadow. -->
    <Grid Margin="8">
        <Border CornerRadius="10" Background="{DynamicResource MenuBg}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.3"/>
            </Border.Effect>
        </Border>
        <Border CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource MenuBorder}" Padding="6,12,6,6">
            <StackPanel>
                <StackPanel Margin="10,0,10,0">
                    <DockPanel>
                        <TextBlock x:Name="Plan" DockPanel.Dock="Right" Style="{StaticResource Dim}" VerticalAlignment="Bottom"/>
                        <TextBlock x:Name="ProviderName" FontSize="15" FontWeight="SemiBold"/>
                    </DockPanel>
                    <TextBlock x:Name="Updated" Style="{StaticResource Dim}" Margin="0,2,0,0"/>
                    <Border Height="1" Background="{DynamicResource MenuBorder}" Margin="0,10"/>
                    <ItemsControl x:Name="Windows">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,12">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Reset}" Style="{StaticResource Dim}" FontSize="12"
                                                   VerticalAlignment="Bottom"/>
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"/>
                                    </DockPanel>
                                    <!-- The bar fills with what is left, as CodexBar's does. -->
                                    <Grid Height="6" Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding Left}"/>
                                            <ColumnDefinition Width="{Binding Used}"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.ColumnSpan="2" CornerRadius="3" Background="{DynamicResource Track}"/>
                                        <Border CornerRadius="3" Background="{Binding Fill}"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="Error" Foreground="#E5484D" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>
                    <Border Height="1" Background="{DynamicResource MenuBorder}" Margin="0,0,0,6"/>
                </StackPanel>
                <Button x:Name="RefreshButton" Style="{StaticResource MenuButton}" Click="Refresh_Click">
                    <TextBlock x:Name="RefreshText" Text="새로 고침"/>
                </Button>
                <Button Style="{StaticResource MenuButton}" Click="Dashboard_Click">
                    <TextBlock Text="사용량 대시보드"/>
                </Button>
                <Border Height="1" Background="{DynamicResource MenuBorder}" Margin="10,6"/>
                <Button Style="{StaticResource MenuButton}" Click="Settings_Click">
                    <TextBlock Text="UsageBar 설정"/>
                </Button>
                <Button Style="{StaticResource MenuButton}" Click="Quit_Click">
                    <TextBlock Text="UsageBar 종료"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
