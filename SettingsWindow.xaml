<Window x:Class="UsageBar.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UsageBar"
        Title="UsageBar 설정" Width="720" Height="480" MinWidth="560" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource MenuFg}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <Window.Resources>
        <!-- Sidebar entry, as in Mindows' settings, with the provider's mark on its color. -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource MenuFg}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="6,5" Margin="0,1">
                            <ContentPresenter x:Name="Hd" ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}"/>
                                <!-- Only the header: the TabItem's own Foreground would pass to a page set as its Content, as 일반's is. -->
                                <Setter TargetName="Hd" Property="TextElement.Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A group of rows, as on macOS. -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MenuBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="MinHeight" Value="44"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RowLine" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource MenuBorder}"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="MaxWidth" Value="300"/>
            <Setter Property="Margin" Value="0,8"/>
        </Style>

        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="36" Height="20" CornerRadius="10" Background="{DynamicResource MenuBorder}">
                            <Ellipse x:Name="Knob" Width="16" Height="16" Margin="2,0" Fill="White" HorizontalAlignment="Left">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.3"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource MenuFg}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="5" Padding="12,4" BorderThickness="1"
                                Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource MenuBorder}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A provider's sidebar entry and page, for the tabs SettingsWindow adds after 일반. -->
        <DataTemplate x:Key="ProviderHeader">
            <StackPanel Orientation="Horizontal">
                <Border Width="22" Height="22" CornerRadius="5" Background="{Binding Color}" Margin="0,0,8,0">
                    <Grid Margin="4">
                        <!-- OpenCode's mark has a gray inner shade; its path repeats the mark's outline so both paths stretch alike. -->
                        <Path Data="{Binding Inner}" Fill="#5A5858" Stretch="Uniform"/>
                        <Path Data="{Binding Logo}" Fill="{Binding LogoFill}" Stretch="Uniform"/>
                    </Grid>
                </Border>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ProviderPage">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <DockPanel Style="{StaticResource Row}" IsEnabled="{Binding CanHide}">
                        <local:Switch DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Shown, Mode=OneTime}"
                                      AutomationProperties.Name="메뉴 바에 표시" Click="Shown_Click"/>
                        <StackPanel VerticalAlignment="Center" Margin="0,8">
                            <TextBlock Text="메뉴 바에 표시"/>
                            <TextBlock Text="{Binding ShownNote}" FontSize="11" Opacity="0.6" Margin="0,2,0,0" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <!-- Without a note, the label centers in the row. -->
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShownNote}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <Button DockPanel.Dock="Right" Content="{Binding LoginLabel}" IsEnabled="{Binding Installed}" Margin="12,0,0,0"
                                    ToolTip="{Binding LoginNote}" ToolTipService.ShowOnDisabled="True" Click="Login_Click"/>
                            <StackPanel VerticalAlignment="Center" Margin="0,8">
                                <TextBlock Text="로그인"/>
                                <TextBlock Text="{Binding Status}" FontSize="11" Opacity="0.6" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Plan}" Style="{StaticResource Value}"/>
                            <TextBlock Text="요금제" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Updated}" Style="{StaticResource Value}"/>
                            <TextBlock Text="업데이트" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <!-- Each TabItem is one category, 일반 and then one per provider: the sidebar lists them, the right pane shows the selected one. -->
    <!-- TabControl's theme style sets the system text color, which would hide the window's. -->
    <TabControl x:Name="Pages" TabStripPlacement="Left" Focusable="False" Foreground="{DynamicResource MenuFg}">
        <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource PaneBg}" BorderBrush="{DynamicResource MenuBorder}" BorderThickness="0,0,1,0">
                        <StackPanel IsItemsHost="True" Margin="10,12" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,16,24,8">
                            <TextBlock Text="{Binding SelectedItem.(AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}"
                                       FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
                            <!-- The part name lets UI Automation, and so screen readers, reach the selected page's controls. -->
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </ControlTemplate>
        </TabControl.Template>

        <TabItem AutomationProperties.Name="일반">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Border Width="22" Height="22" CornerRadius="5" Background="#636366" Margin="0,0,8,0">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="일반" VerticalAlignment="Center"/>
                </StackPanel>
            </TabItem.Header>
            <Border Style="{StaticResource Card}">
                <DockPanel Style="{StaticResource Row}">
                    <local:Switch x:Name="LaunchAtLogin" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                  AutomationProperties.Name="로그인 시 자동 실행" Click="LaunchAtLogin_Click"/>
                    <TextBlock Text="로그인 시 자동 실행" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </TabItem>
    </TabControl>
</Window>
