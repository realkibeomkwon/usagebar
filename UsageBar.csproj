<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>UsageBar</RootNamespace>
    <Version>1.0.0</Version>
    <!-- Per-monitor DPI like Mindows, whose popup coordinates are physical pixels. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFO0003 wants WinForms' ApplicationHighDpiMode, which only WinForms' own startup applies; the WPF windows need the manifest. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\*.png" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <!-- Windows Forms is here only for the tray icon; its names would clash with WPF's. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
